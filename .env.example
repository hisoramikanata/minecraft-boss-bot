# 接続先サーバー(自分が所有/参加許可のあるサーバーのみを指定すること)
MC_HOST=localhost
MC_PORT=25565

# Botのアカウント名
MC_USERNAME=BossSlayerBot

# 認証方式: offline(統合版/オフラインサーバー) | microsoft(正規アカウントでログイン)
MC_AUTH=offline

# MC_AUTH=microsoft のときのみ使用。空なら初回起動時にデバイスコード認証が案内される
MC_PASSWORD=

# 接続先サーバーのバージョン。空なら自動検出
MC_VERSION=1.20.4

# チャットコマンドを受け付けるプレイヤー名(未設定なら全員を許可)
MC_ADMIN=

# ウォーデンに遭遇した際、回避に徹するか(true推奨)。falseにすると危険な応戦ロジックを使う
WARDEN_AVOID_ONLY=true
